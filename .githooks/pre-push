#!/bin/sh
# Refuse to push a release tag (v*) when the tagged commit has no matching
# changelog file. The changelog drives the GitHub/Modrinth/CurseForge release
# notes: changelogs/<base-version>.md, where the base version is the tag
# without the leading v and without the +<mc-version> suffix.
# One-time setup per clone: git config core.hooksPath .githooks

zero=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/v*)
            # Tag deletion: nothing to check
            [ "$local_sha" = "$zero" ] && continue
            tag="${remote_ref#refs/tags/v}"
            base="${tag%%+*}"
            file="changelogs/${base}.md"
            if ! git cat-file -e "${local_sha}:${file}" 2>/dev/null; then
                echo "error: ${file} is missing from the tagged commit (${remote_ref#refs/tags/})" >&2
                echo "write it, commit it, move the tag, then push again" >&2
                exit 1
            fi
            ;;
    esac
done
exit 0
